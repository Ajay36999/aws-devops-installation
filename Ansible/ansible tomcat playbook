---
- hosts: tomcat
  tasks:
    - name: update
      ansible.builtin.apt: update_cache=yes
    - name: create /opt/tomcat directory
      ansible.builtin.file: path=/opt/tomcat state=directory mode=777
    - name: download tomcat
      ansible.builtin.get_url: url=https://dlcdn.apache.org/tomcat/tomcat-9/v9.0.123/bin/apache-tomcat-9.0.123.tar.gz dest=/opt/tomcat
    - name: extraction
      ansible.builtin.unarchive: src=/opt/tomcat/apache-tomcat-9.0.123.tar.gz dest=/opt/tomcat/ remote_src=yes
    - name: java
      become: yes
      ansible.builtin.apt: name=openjdk-11-jdk state=present update_cache=yes
    - name: Start Tomcat server
      become: yes
      ansible.builtin.shell: bash startup.sh
      args:
        chdir: /opt/tomcat/apache-tomcat-9.0.123/bin
    - name: copy the .war to tomcat
      ansible.builtin.copy: src=/root/WebApp.war dest=/opt/tomcat/apache-tomcat-9.0.123/webapps
~
